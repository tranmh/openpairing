# OpenPairing Environment Configuration
# Copy this file to .env and customize for your environment

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=openpairing
POSTGRES_PASSWORD=openpairing_dev
POSTGRES_DB=openpairing
POSTGRES_PORT=5432

# Full connection string (constructed from above or override directly)
DATABASE_URL=postgres://openpairing:openpairing_dev@localhost:5432/openpairing?sslmode=disable

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===========================================
# MinIO (S3-compatible storage)
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=openpairing

# ===========================================
# Application Ports
# ===========================================
API_PORT=8080
CHESS_PORT=8081
FRONTEND_PORT=3000

# ===========================================
# Authentication
# ===========================================
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ===========================================
# Environment
# ===========================================
ENVIRONMENT=development
LOG_LEVEL=debug

# ===========================================
# Federation API Keys
# ===========================================
# German Chess Federation (DSB) API
DSB_API_KEY=
DSB_API_URL=https://www.schachbund.de/php/dewis/

# FIDE Rating List URL (no auth required)
FIDE_RATING_LIST_URL=https://ratings.fide.com/download/players_list_xml.zip

# Austrian Chess Federation (ÖSB)
OESB_API_URL=https://chess-results.com

# ===========================================
# Email Configuration (SendGrid)
# ===========================================
SENDGRID_API_KEY=
EMAIL_FROM=noreply@openpairing.com
EMAIL_FROM_NAME=OpenPairing

# ===========================================
# Stripe Payment Configuration
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8081
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# CORS Configuration
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# Rate Limiting
# ===========================================
# Set to false to disable rate limiting (useful for development)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
